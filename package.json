{
  "name": "dsh-prompt-palette",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt palette for the DSH web composer.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "index.js",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.ts tests/placement.test.ts tests/storage.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
